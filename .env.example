# Шаблон змінних середовища LifeHub.
# Скопіюйте у .env і заповніть значення. Файли .env* (крім цього) не комітяться.
# .env читають і Next.js, і Prisma CLI (через prisma.config.ts).
# Змінні додаються сюди в тій задачі roadmap, де вони з'являються:
#   день 3 — DATABASE_URL, TEST_DATABASE_URL
#   день 5 — AUTH_SECRET, облікові дані початкового користувача
#   тиждень 16 — ANTHROPIC_API_KEY, AI_MODEL

# PostgreSQL для розробки — гілка `dev` проєкту Neon (ADR 0002).
# Рядок direct (без connection pooling, у хості немає "-pooler"): його використовують і застосунок, і `prisma migrate`.
# Формат: postgresql://<role>:<password>@<host>/<database>?sslmode=verify-full&channel_binding=require
# Neon видає рядок із sslmode=require — замініть на verify-full: node-postgres уже зараз трактує require
# як verify-full, а без явного verify-full друкує попередження безпеки. Prisma CLI підтримує обидва.
DATABASE_URL=

# PostgreSQL для integration-тестів — гілка `test` (дані стираються тестами). Використовується з дня 4:
# налаштування тестів підставляє його в DATABASE_URL до першого звернення до `db`.
# Команди `db:*` завжди працюють з DATABASE_URL (тобто з `dev`), а не з цією змінною.
TEST_DATABASE_URL=
